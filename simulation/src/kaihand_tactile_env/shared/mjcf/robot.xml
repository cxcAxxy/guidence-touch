<mujoco model="kaihand_shared_robot">
  <!--
    Shared dual-arm KaiHand workcell.

    Task objects deliberately do not live in this file. All task scenes
    include this exact robot definition so joint, actuator, camera, and
    tactile geometry names stay identical across independently compiled
    models. Robot physics mirror the legacy workcell model; the head camera
    uses the shared USB-derived observation calibration.
  -->

  <include file="../../assets/workcell/mjcf/hand_asset.xml"/>

  <compiler angle="radian" meshdir="../../assets/workcell/meshes/"
            autolimits="true" balanceinertia="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"
          iterations="80" cone="elliptic"/>
  <visual>
    <global offwidth="1280" offheight="720"/>
    <quality shadowsize="4096"/>
    <!-- Default znear clips away wrist-adjacent surfaces at ~42 mm in USB.
         Keep near surfaces down to ~2 mm without moving any sensor camera. -->
    <map znear="0.0005"/>
    <headlight ambient="0.25 0.25 0.25" diffuse="0.4 0.4 0.4"
               specular="0.3 0.3 0.3"/>
  </visual>

  <default>
    <!-- Shared observation calibration, adopted from USB insertion. Scope it
         to the robot head only: free/global and task close-up cameras retain
         their independent extrinsics. New tasks inherit this exact camera. -->
    <default class="robot_head_camera">
      <camera pos="0.11 0 1.28" fovy="70"
              xyaxes="0 -1 0 0.76229408 0 0.64723082"/>
    </default>
    <!-- Right wrist camera, expressed in the rigid hand-mount frame:
         +Y is palm-facing (down for palm-down draw), -Z points to fingers.
         An optical sensor only: no extra mass, contacts, or tracking target. -->
    <default class="robot_right_wrist_camera">
      <camera pos="0 0.035 0.025" fovy="85"
              xyaxes="-1 0 0 0 -0.98 -0.20"/>
    </default>
    <!-- The hand meshes mirror local Y. Mirror position and optical/up axes;
         reverse the image X axis to keep a proper right-handed camera frame. -->
    <default class="robot_left_wrist_camera">
      <camera pos="0 -0.035 0.025" fovy="85"
              xyaxes="1 0 0 0 0.98 -0.20"/>
    </default>
    <default class="arm_joint">
      <joint type="hinge" axis="0 0 1" damping="3.0" armature="0.05"
             frictionloss="0.1" limited="true"/>
    </default>
    <default class="arm_visual">
      <geom contype="0" conaffinity="0" group="1" material="arm_visual"/>
    </default>
    <default class="arm_collision">
      <!-- Bit 2 collides with scene masks; arm proxies do not collide together. -->
      <geom contype="2" conaffinity="0" group="4" rgba="1 0 0 0.18"
            condim="4" friction="0.9 0.02 0.002"/>
    </default>
  </default>

  <asset>
    <!-- White/silver lab v2: appearance only. Retain historical material names,
         all geometry, sensor calibration, and physical contact parameters. -->
    <texture name="lab_sky" type="skybox" builtin="gradient"
             rgb1="1 1 1" rgb2="1 1 1"
             width="256" height="1536"/>
    <texture name="grid" type="2d" builtin="flat" rgb1="0.96 0.96 0.96"
             rgb2="0.96 0.96 0.96" width="512" height="512"/>
    <texture name="worktop_finish" type="2d"
             file="../../assets/workcell/textures/dark_grey_marble_v1.png"/>
    <material name="grid" texture="grid" texrepeat="1 1" texuniform="true"
              specular="0.08" shininess="0.12"/>
    <material name="arm_visual" rgba="0.94 0.94 0.94 1"
              specular="0.22" shininess="0.35"/>
    <material name="arm_red" rgba="0.90 0.90 0.90 1"
              specular="0.22" shininess="0.35"/>
    <material name="arm_green" rgba="0.96 0.96 0.96 1"
              specular="0.22" shininess="0.35"/>
    <material name="arm_blue" rgba="0.94 0.94 0.94 1"
              specular="0.22" shininess="0.35"/>
    <material name="torso_visual" rgba="0.94 0.94 0.94 1"
              specular="0.22" shininess="0.35"/>
    <material name="table" texture="worktop_finish" texrepeat="1 1"
              texuniform="true" specular="0.05" shininess="0.12"/>
    <material name="table_frame" rgba="0.50 0.52 0.54 1"
              specular="0.05" shininess="0.12"/>

    <mesh name="tianji_base" file="tianji_m6/base/ZJ_Robot_link.STL"/>
    <mesh name="tianji_Base_L" file="tianji_m6/m6/Base_L.STL"/>
    <mesh name="tianji_Link1_L" file="tianji_m6/m6/Link1_L.STL"/>
