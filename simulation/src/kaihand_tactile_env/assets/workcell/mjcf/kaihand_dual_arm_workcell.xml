                      <geom type="capsule" fromto="0 0 0 0 -0.088 0" size="0.031"
                            class="arm_collision"/>

                      <body name="left_arm_flange" pos="0 -0.088 0"
                            quat="0.5 0.5 -0.5 0.5">
                        <site name="left_ee_site" size="0.012" rgba="0.15 0.85 0.35 1"/>
                        <body name="left_hand_mount" euler="0 3.141592653589793 0">
                          <include file="hand_l_body.xml"/>
                        </body>
                      </body>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>

