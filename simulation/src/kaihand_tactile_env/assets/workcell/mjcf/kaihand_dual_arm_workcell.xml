<mujoco model="kaihand_dual_arm_workcell">
  <!--
    Tianji Marvin M6 CCS V4 arm model with KaiHand end effectors.

    Each arm uses the modified-DH convention from ccs_m6.MvKDCfg:
      T_i = Rx(alpha_i) Tx(a_i) Rz(theta_offset_i + q_i) Tz(d_i)

    The arm transforms, visual meshes, inertias and limits come from the
    Tianji V4 description supplied with the robot.  Convex primitives remain
    separate from the high-resolution visual meshes for stable contact.
  -->

  <include file="hand_asset.xml"/>

  <compiler angle="radian" meshdir="../meshes/" autolimits="true"
            balanceinertia="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"
          iterations="80" cone="elliptic"/>
  <visual>
    <global offwidth="1280" offheight="720"/>
  </visual>

  <default>
    <default class="arm_joint">
      <joint type="hinge" axis="0 0 1" damping="3.0" armature="0.05"
             frictionloss="0.1" limited="true"/>
    </default>
    <default class="arm_visual">
      <geom contype="0" conaffinity="0" group="1" material="arm_visual"/>
    </default>
    <default class="arm_collision">
      <!-- Bit 2 collides with the scene masks below, while conaffinity=0
           prevents approximate proxy capsules from fighting one another. -->
      <geom contype="2" conaffinity="0" group="4" rgba="1 0 0 0.18"
            condim="4" friction="0.9 0.02 0.002"/>
    </default>
  </default>

  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.12 0.16 0.20"
             rgb2="0.20 0.25 0.30" width="300" height="300"/>
    <material name="grid" texture="grid" texrepeat="8 8" texuniform="true"/>
    <material name="arm_visual" rgba="0.28 0.38 0.52 1"/>
    <material name="arm_red" rgba="0.72 0.10 0.10 1"/>
    <material name="arm_green" rgba="0.10 0.62 0.18 1"/>
    <material name="arm_blue" rgba="0.10 0.24 0.72 1"/>
    <material name="torso_visual" rgba="0.72 0.74 0.78 1"/>
    <material name="table" rgba="0.43 0.31 0.21 1"/>
    <material name="cylinder" rgba="0.85 0.25 0.18 1"/>
    <material name="box" rgba="0.08 0.32 0.88 1"/>
    <material name="poker_felt" rgba="0.05 0.33 0.19 1"/>
    <material name="card_back" rgba="0.62 0.08 0.10 1"/>
    <material name="card_face" rgba="0.96 0.94 0.88 1"/>

    <mesh name="tianji_base" file="tianji_m6/base/ZJ_Robot_link.STL"/>
    <mesh name="tianji_Base_L" file="tianji_m6/m6/Base_L.STL"/>
    <mesh name="tianji_Link1_L" file="tianji_m6/m6/Link1_L.STL"/>
    <mesh name="tianji_Link2_L" file="tianji_m6/m6/Link2_L.STL"/>
    <mesh name="tianji_Link3_L" file="tianji_m6/m6/Link3_L.STL"/>
    <mesh name="tianji_Link4_L" file="tianji_m6/m6/Link4_L.STL"/>
    <mesh name="tianji_Link5_L" file="tianji_m6/m6/Link5_L.STL"/>
    <mesh name="tianji_Link6_L" file="tianji_m6/m6/Link6_L.STL"/>
    <mesh name="tianji_Link7_L" file="tianji_m6/m6/Link7_L.STL"/>
    <mesh name="tianji_Base_R" file="tianji_m6/m6/Base_R.STL"/>
    <mesh name="tianji_Link1_R" file="tianji_m6/m6/Link1_R.STL"/>
    <mesh name="tianji_Link2_R" file="tianji_m6/m6/Link2_R.STL"/>
    <mesh name="tianji_Link3_R" file="tianji_m6/m6/Link3_R.STL"/>
    <mesh name="tianji_Link4_R" file="tianji_m6/m6/Link4_R.STL"/>
    <mesh name="tianji_Link5_R" file="tianji_m6/m6/Link5_R.STL"/>
    <mesh name="tianji_Link6_R" file="tianji_m6/m6/Link6_R.STL"/>
    <mesh name="tianji_Link7_R" file="tianji_m6/m6/Link7_R.STL"/>
  </asset>

  <worldbody>
    <light name="top" pos="0 0 3" dir="0 0 -1" directional="true"/>
    <light name="front" pos="2 -1 2" dir="-1 0 -0.5"/>
    <!-- Fixed calibrated cameras.  MuJoCo cameras look along local -Z. -->
    <camera name="overhead" pos="0.56 0 1.75"
            xyaxes="1 0 0 0 1 0" fovy="52"/>
    <camera name="front" pos="1.45 0 1.02"
            xyaxes="0 1 0 0 0 1" fovy="50"/>
    <geom name="ground" type="plane" size="3 3 0.05" pos="0 0 0"
          contype="3075" conaffinity="3075" material="grid"
          friction="1.0 0.02 0.002"/>
    <body name="table" pos="0.58 0 0.64">
      <!-- 3 x 3 m top covers the complete 4:3 head-camera frustum at z=0.68. -->
      <geom name="tabletop" type="box" size="1.50 1.50 0.04"
            contype="3075" conaffinity="3075" material="table"
            friction="1.1 0.02 0.002"/>
      <geom name="table_leg_front" type="box" pos="0.42 0 -0.32"
            size="0.06 0.50 0.28" contype="1" conaffinity="1"
            material="table"/>
    </body>

    <body name="torso">
      <inertial pos="0.0081994 -0.0000051239 0.47835"
                quat="0.999994 0.0000257224 0.0031361 0.00173711"
                mass="18.846" diaginertia="0.463463 0.46325 0.377657"/>
      <geom name="torso_visual" type="mesh" mesh="tianji_base"
            contype="0" conaffinity="0" group="1" material="torso_visual"/>
      <geom name="torso_collision" type="capsule" fromto="0 0 0 0 0 1.3"
            size="0.06" contype="1" conaffinity="1" group="4"
            rgba="1 0 0 0.18"/>
      <!-- Robot-mounted eye-in-hand-style overview camera.  Its pose is fixed
           in the torso/head frame, so exported extrinsics follow the robot. -->
      <camera name="head" pos="0.04 0 1.42"
              xyaxes="0 -1 0 0.768 0 0.640" fovy="58"/>

      <!-- Official V4 shoulder placement and mesh-aligned base orientation. -->
      <body name="left_arm_base" pos="0 0.026 1.121"
            quat="0.707388 -0.706825 0 0">
        <inertial pos="0.00032267 0.00004798 0.0406635"
                  quat="0.582787 0.36644 -0.620273 0.375956"
                  mass="1.1962" diaginertia="0.00127375 0.00107367 0.00106904"/>
        <geom type="mesh" mesh="tianji_Base_L" class="arm_visual"
              material="arm_red"/>
        <geom type="cylinder" size="0.065 0.055" class="arm_collision"/>

        <body name="left_arm_link1" pos="0 0 0.1745">
          <inertial pos="0.00002347 0.0055715 -0.03076"
                    quat="0.711599 0.0343691 -0.0341702 0.700912"
                    mass="1.9705" diaginertia="0.00529754 0.00492285 0.00184874"/>
          <joint name="left_arm_joint1" class="arm_joint"
