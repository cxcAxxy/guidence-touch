                    <joint name="right_arm_joint6" class="arm_joint"
                           range="-1.04719755120 1.04719755120"/>
                    <geom type="mesh" mesh="tianji_Link6_R" class="arm_visual"
                          material="arm_red"/>
                    <geom type="sphere" size="0.038" class="arm_collision"/>

                    <body name="right_arm_link7" quat="0.5 0.5 -0.5 0.5">
                      <inertial pos="-0.00009108 -0.0315325 0.00889371"
                                quat="0.84481 0.535026 0.00229584 -0.00609725"
                                mass="0.68606" diaginertia="0.00173691 0.00153911 0.000745263"/>
                      <joint name="right_arm_joint7" class="arm_joint"
                             range="-1.57079632679 1.57079632679"/>
                      <geom type="mesh" mesh="tianji_Link7_R_shell_visual" class="arm_visual"
                            material="arm_green"/>
                      <geom type="capsule" fromto="0 0 0 0 -0.088 0" size="0.031"
                            class="arm_collision"/>

                      <body name="right_arm_flange" pos="0 -0.088 0"
                            quat="0.5 0.5 -0.5 0.5">
                        <site name="right_ee_site" size="0.012" rgba="1 0.55 0.12 1"/>
                        <!-- At ARM_HOME this local rotation is exactly a
                             world-Z half-turn.  Keep it separate from the
                             physical Joint7-axis mounting correction below so
                             both calibration operations remain explicit. -->
                        <body name="right_hand_world_z_home_correction"
                              quat="0 -0.02579857 0.99964256 -0.00701268">
                          <!-- In the flange frame, +X is the Joint7 axis. -->
                          <body name="right_hand_axis_flip"
                                euler="3.141592653589793 0 0">
                            <body name="right_hand_mount"
                                  euler="0 3.141592653589793 3.141592653589793">
                              <include file="hand_r_body.xml"/>
                            </body>
                          </body>
                        </body>
                      </body>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- Mocap bodies visualize the commanded Cartesian targets. -->
    <body name="left_target" mocap="true" pos="0.55 0.45 1.15">
    </body>
    <body name="right_target" mocap="true" pos="0.55 -0.45 1.15">
    </body>

    <!-- Cup-sized upright cylinder for a five-finger power grasp. -->
    <body name="cylinder" pos="0.56 -0.20 0.77">
      <freejoint name="cylinder_freejoint"/>
      <geom name="cylinder_geom" type="cylinder" size="0.035 0.09"
            mass="0.08" contype="3075" conaffinity="3075"
            friction="5.0 0.05 0.005" margin="0.001" material="cylinder"/>
    </body>
    <!-- Fixed open-top receptacle.  Inner footprint is 14 x 14 cm. -->
    <!-- The body's z origin coincides with the tabletop, so the bottom plate
         rests on z=0.68 instead of floating 20 mm above it. -->
    <body name="box" pos="0.56 -0.02 0.68">
      <geom name="box_bottom" type="box" pos="0 0 0.006"
            size="0.08 0.08 0.006" contype="3075" conaffinity="3075"
            friction="1.0 0.02 0.002" material="box"/>
      <geom name="box_wall_x_pos" type="box" pos="0.076 0 0.056"
            size="0.004 0.08 0.05" contype="3075" conaffinity="3075" material="box"/>
      <geom name="box_wall_x_neg" type="box" pos="-0.076 0 0.056"
            size="0.004 0.08 0.05" contype="3075" conaffinity="3075" material="box"/>
      <geom name="box_wall_y_pos" type="box" pos="0 0.076 0.056"
            size="0.072 0.004 0.05" contype="3075" conaffinity="3075" material="box"/>
      <geom name="box_wall_y_neg" type="box" pos="0 -0.076 0.056"
            size="0.072 0.004 0.05" contype="3075" conaffinity="3075" material="box"/>
    </body>

    <!-- Poker-draw scene: a 16 cm raised felt table and one face-down poker
         card.  The scene is activated by ArmHandSimulation(scene="poker-draw")
         and is hidden/non-colliding for the unchanged pick-and-place task. -->
    <body name="poker_table" pos="0.58 -0.18 0.76">
      <geom name="poker_table_base" type="box" size="0.115 0.070 0.080"
            contype="11264" conaffinity="11264" material="table"
            friction="0.10 0.005 0.0005" priority="2"
            solref="0.002 1" solimp="0.98 0.995 0.0005"/>
      <geom name="poker_table_top" type="box" pos="0 0 0.0805"
            size="0.115 0.070 0.0005" contype="11264" conaffinity="11264"
            material="poker_felt" friction="0.10 0.005 0.0005" priority="2"
            solref="0.002 1" solimp="0.98 0.995 0.0005"/>
    </body>
    <!-- Standard poker-card footprint: 63 x 88 mm, face-down at reset.  The
         red back is a visual shell above the colliding rigid card core; the
         light face is visible from below once the thumb reaches the overhang. -->
    <body name="card" pos="0.58 -0.16 0.84175">
      <joint name="card_freejoint" type="free" damping="0.002"/>
      <geom name="card_core_geom" type="box" size="0.0315 0.0440 0.00055"
            mass="0.004" contype="12289" conaffinity="12289"
            friction="1.40 0.02 0.002" priority="1" margin="0.00035"
            solref="0.002 1" solimp="0.98 0.995 0.0005 0.5 2"
            material="card_face"/>
      <geom name="card_back_visual" type="box" pos="0 0 0.00062"
            size="0.0305 0.0430 0.00008" contype="0" conaffinity="0"
            material="card_back"/>
      <geom name="card_face_visual" type="box" pos="0 0 -0.00062"
            size="0.0305 0.0430 0.00008" contype="0" conaffinity="0"
            material="card_face"/>
    </body>
  </worldbody>

  <equality>
    <!-- Activated only after physical finger closure and released above box. -->
    <weld name="right_grasp_stabilizer" body1="hand_r_base_link"
          body2="cylinder" active="false" solref="0.005 1"
          solimp="0.95 0.99 0.001"/>
