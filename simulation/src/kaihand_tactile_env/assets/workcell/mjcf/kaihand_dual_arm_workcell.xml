                  mass="1.1962" diaginertia="0.00127375 0.00107367 0.00106904"/>
        <geom type="mesh" mesh="tianji_Base_R" class="arm_visual"
              material="arm_red"/>
        <geom type="cylinder" size="0.065 0.055" class="arm_collision"/>

        <body name="right_arm_link1" pos="0 0 0.1745">
          <inertial pos="0.00002347 0.0055715 -0.03076"
                    quat="0.711599 0.0343691 -0.0341702 0.700912"
                    mass="1.9705" diaginertia="0.00529754 0.00492285 0.00184874"/>
          <joint name="right_arm_joint1" class="arm_joint"
                 range="-3.1067 3.1067"/>
          <geom type="mesh" mesh="tianji_Link1_R" class="arm_visual"
                material="arm_green"/>
          <geom type="sphere" size="0.062" class="arm_collision"/>

          <body name="right_arm_link2" quat="0.707106781187 0.707106781187 0 0">
            <inertial pos="0.00013483 0.0617046 0.00950639"
                      quat="0.643375 0.765551 -0.0000357328 0.000294349"
                      mass="2.24398" diaginertia="0.0119493 0.0112156 0.00338374"/>
            <joint name="right_arm_joint2" class="arm_joint"
                   range="-2.09439510239 2.09439510239"/>
            <geom type="mesh" mesh="tianji_Link2_R" class="arm_visual"
                  material="arm_blue"/>
            <geom type="capsule" fromto="0 0 0 0 0.287 0" size="0.046"
                  class="arm_collision"/>

            <body name="right_arm_link3" pos="0 0.287 0"
                  quat="0.707106781187 -0.707106781187 0 0">
              <inertial pos="0.00968562 0.00246599 -0.046273"
                        quat="0.782446 -0.0355285 -0.0735516 0.617337"
                        mass="1.9242" diaginertia="0.00765215 0.00730789 0.0016338"/>
              <joint name="right_arm_joint3" class="arm_joint"
                     range="-3.1067 3.1067"/>
              <geom type="mesh" mesh="tianji_Link3_R" class="arm_visual"
                    material="arm_red"/>
              <geom type="sphere" size="0.053" class="arm_collision"/>

              <body name="right_arm_link4" pos="0.018 0 0"
                    quat="0 0 -0.707106781187 0.707106781187">
                <inertial pos="0.00850411 -0.0471822 0.00941509"
                          quat="0.741754 0.628694 0.0774999 -0.220317"
                          mass="1.6085" diaginertia="0.00603244 0.00535875 0.00198228"/>
                <joint name="right_arm_joint4" class="arm_joint"
                       range="-2.5307 1.0472"/>
                <geom type="mesh" mesh="tianji_Link4_R" class="arm_visual"
                      material="arm_green"/>
                <geom type="capsule" fromto="0 0 0 0.018 -0.314 0" size="0.041"
                      class="arm_collision"/>

                <body name="right_arm_link5" pos="0.018 -0.314 0"
                      quat="0 0 -0.707106781187 0.707106781187">
                  <inertial pos="-0.00051127 -0.00101064 -0.112717"
                            quat="0.999438 0.00995046 0.00675781 0.0312997"
                            mass="2.0883" diaginertia="0.00626924 0.00564262 0.00243436"/>
                  <joint name="right_arm_joint5" class="arm_joint"
                         range="-3.1067 3.1067"/>
                  <geom type="mesh" mesh="tianji_Link5_R" class="arm_visual"
                        material="arm_blue"/>
                  <geom type="sphere" size="0.045" class="arm_collision"/>

                  <body name="right_arm_link6" quat="0.5 0.5 -0.5 0.5">
