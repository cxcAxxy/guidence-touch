# Copy to oa_guidance.env and set external paths; never commit credentials.
OA_CHECKPOINT=/path/to/datasets/touchguidence/YOUR_TRAINING_RUN/best.pt
OA_DATA_ROOT=/path/to/datasets/touchguidence/augmentation/poker_fingertip_recovery_rules_v1_random10/ratio_1_1
BASE_CHECKPOINT=/path/to/datasets/sim/poker-draw/pi05_trex/pi05_pytorch_20k
MODEL_PYTHON=/path/to/touchguidance/bin/python
SIM_PYTHON=/path/to/simulator-env/bin/python
# SIM_ROOT may point to an external kaihand simulator; the bundled simulation/ is used when available.
TOKENIZER_MODEL=$HOME/.cache/openpi/big_vision/paligemma_tokenizer.model
OUTPUT_ROOT=/path/to/datasets/touchguidence/eval
EXECUTE_STEPS=5
GUIDANCE_SCALE=1.0
GUIDANCE_STEPS=3
NUM_TRIALS=10
SEED_START=0
GPU_ID=0
MAX_SIM_SECONDS=50
SUCCESS_HOLD_SECONDS=5
VIDEO_MODE=head-only
COMPARE_BASE=1
SAVE_POLICY_TRACES=1
REFERENCE_DATASET=
# DRY_RUN=1 prints launch commands after path checks.
